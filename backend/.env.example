DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=social_db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
PORT=4000
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=
PUBLIC_API_URL=http://localhost:4000/api

# Stripe-hosted Checkout for paid ad campaigns. Never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Initial superadmins (comma-separated registered email addresses)
SUPERADMIN_EMAILS=
# Legacy moderator bootstrap list; use SUPERADMIN_EMAILS for the first superadmin
MODERATOR_EMAILS=

# Meta OAuth. Add this exact callback URL to the Meta app's Valid OAuth Redirect URIs.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/social/callback
META_GRAPH_VERSION=v25.0
